# FairDraw Environment Configuration
# Copy this file to .env and fill in the values

# Admin password for managing draws (REQUIRED)
ADMIN_PASSWORD=change-me-to-a-strong-password

# Session secret for cookie encryption (REQUIRED, use a random string)
SESSION_SECRET=generate-a-random-64-char-string-here

# Port for the server (optional, default: 3001)
PORT=3001

# CORS origin (optional, default: http://localhost:3001)
CORS_ORIGIN=http://localhost:3001

# Node environment (optional, default: production in Docker)
NODE_ENV=production
